# Application settings
APP_NAME=agentic-api
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# LangSmith / LangChain tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key
LANGCHAIN_PROJECT=agentic-api

# Conversation memory (LangGraph SQLite checkpointer)
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# API authentication (optional; if set, X-API-Key becomes required on /agent/* routes)
# AGENTIC_API_KEY=change-me-a-strong-random-key
