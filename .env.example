# Application settings
APP_NAME=agentic-api            # Application name shown in FastAPI docs.
APP_VERSION=0.1.0               # Application version.
ENVIRONMENT=development         # Deployment environment (console logs in development, JSON otherwise).
DEBUG=false                     # Enables FastAPI debug mode.
API_PREFIX=/api/v1              # Prefix for all agent API routes.
LOG_LEVEL=INFO                  # Root logging level.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key  # OpenAI API key used by the planner LLM.

# Langfuse tracing (optional: tracing is active only when BOTH keys are set)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key      # Langfuse project public key (Settings > API Keys).
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key      # Langfuse project secret key (shown once at creation).
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # Data region: EU https://cloud.langfuse.com | US https://us.cloud.langfuse.com | JP https://jp.cloud.langfuse.com | HIPAA https://hipaa.cloud.langfuse.com

# LangSmith / LangChain tracing (optional, legacy; uncomment only if you want LangSmith as well)
# LANGCHAIN_TRACING_V2=false                            # Enables LangSmith tracing.
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com    # LangSmith API endpoint.
# LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key         # LangSmith API key.
# LANGCHAIN_PROJECT=agentic-api                         # LangSmith project name for traces.

# Conversation memory (LangGraph SQLite checkpointer)
CHECKPOINT_DB_PATH=data/checkpoints.sqlite  # SQLite file used to persist conversation memory.

# API authentication (optional; if set, X-API-Key becomes required on /agent/* routes)
# AGENTIC_API_KEY=change-me-a-strong-random-key

# Rate limiting
RATE_LIMIT_PER_MINUTE=60  # Per-client request budget on /agent/* endpoints (0 disables).

# Web search tool
SEARCH_PROVIDER=auto  # Web search provider: auto | duckduckgo | none ("none" disables outbound search for fully offline runs).

# Prompt registry
PROMPTS_DIR=prompts        # Directory holding versioned prompt artifacts and registry.json.
PROMPT_ADMIN_OPEN=false    # Dev-only: allow /prompts write endpoints when AGENTIC_API_KEY is unset.
