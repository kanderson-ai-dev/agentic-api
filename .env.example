# Application settings
APP_NAME=agentic-api            # Application name shown in FastAPI docs.
APP_VERSION=0.1.0               # Application version.
ENVIRONMENT=development         # Deployment environment (console logs in development, JSON otherwise).
DEBUG=false                     # Enables FastAPI debug mode.
API_PREFIX=/api/v1              # Prefix for all agent API routes.
LOG_LEVEL=INFO                  # Root logging level.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key  # OpenAI API key used by the planner LLM.

# LangSmith / LangChain tracing
LANGCHAIN_TRACING_V2=true                               # Enables LangSmith tracing.
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com      # LangSmith API endpoint.
LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key           # LangSmith API key.
LANGCHAIN_PROJECT=agentic-api                           # LangSmith project name for traces.

# Conversation memory (LangGraph SQLite checkpointer)
CHECKPOINT_DB_PATH=data/checkpoints.sqlite  # SQLite file used to persist conversation memory.

# API authentication (optional; if set, X-API-Key becomes required on /agent/* routes)
# AGENTIC_API_KEY=change-me-a-strong-random-key

# Rate limiting
RATE_LIMIT_PER_MINUTE=60  # Per-client request budget on /agent/* endpoints (0 disables).
